   "source": [
    "# Question 21\n",
    "\n",
    "\n",
    "a = 1\n",
    "b = 2\n",
    "count = 2  # We already have the first two terms\n",
    "\n",
    "\n",
    "while count < 100:\n",
    "    # Update values: b becomes the sum, a becomes the old b\n",
    "    a, b = b, a + b\n",
    "    count += 1\n",
    "\n",
    "print(f\"The 100-th term is: {b}\")"
   ]
