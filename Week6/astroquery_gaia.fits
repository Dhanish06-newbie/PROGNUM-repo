                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                XTENSION= 'BINTABLE'           / binary table extension                         BITPIX  =                    8 / array data type                                NAXIS   =                    2 / number of array dimensions                     NAXIS1  =                   48 / length of dimension 1                          NAXIS2  =                   50 / length of dimension 2                          PCOUNT  =                    0 / number of group parameters                     GCOUNT  =                    1 / number of groups                               TFIELDS =                    8 / number of table fields                         TTYPE1  = 'SOURCE_ID'                                                           TFORM1  = 'K       '                                                            TNULL1  =               999999                                                  TTYPE2  = 'ra      '                                                            TFORM2  = 'D       '                                                            TUNIT2  = 'deg     '                                                            